{
    "install": "composer require hihaho/hihaho-php",
    "setup": "use Hihaho\\Sdk\\Hihaho;\n\n$hihaho = new Hihaho(token: 'your-token');",
    "samples": {
        "api.v2.video-container.index": "foreach ($hihaho->folders()->list() as $folder) {\n    echo $folder->name;\n}",
        "api.v2.video-container.create-child": "$folder = $hihaho->folders()->createChild(parentId: 7, name: 'Team A', externalIdentifier: 'team-a');",
        "api.v2.video-container.upload-video.index": "foreach ($hihaho->uploads()->list(folderId: 7) as $upload) {\n    echo $upload->id;\n}",
        "api.v2.video-container.upload-video.store": "// upload() registers, sends and finishes in one call.\n$upload = $hihaho->uploads()->upload(folderId: 7, file: '/path/to/video.mp4');\n\n// Or register only:\n$ticket = $hihaho->uploads()->register(folderId: 7, name: 'video.mp4', size: 1048576);",
        "api.v2.video-container.upload-video.destroy.failed": "$hihaho->uploads()->deleteFailed(folderId: 7);",
        "api.v2.video-container.video-from-platform": "use Hihaho\\Sdk\\Enums\\VideoPlatform;\n\n$video = $hihaho->videos()->createFromPlatform(folderId: 7, platformReference: 'https://vimeo.com/76979871', platform: VideoPlatform::Vimeo);",
        "api.v2.upload-video.video.show": "$upload = $hihaho->uploads()->get(9001);\n\necho $upload->isComplete() ? 'ready' : $upload->statusDescription;",
        "api.v2.upload-video.video.store": "$video = $hihaho->uploads()->createVideo(9001);",
        "api.v2.upload-video.finished": "$hihaho->uploads()->finish(9001);",
        "api.v2.video.index": "use Hihaho\\Sdk\\Enums\\VideoStatus;\n\nforeach ($hihaho->videos()->list(search: 'safety', status: VideoStatus::Published) as $video) {\n    echo $video->displayName;\n}",
        "api.v2.video.show": "$video = $hihaho->video(123)->get();\n\necho $video->playerUrl;",
        "api.v2.video.update": "use Hihaho\\Sdk\\Enums\\Locale;\nuse Hihaho\\Sdk\\Input\\VideoUpdate;\n\n$video = $hihaho->video(123)->update(VideoUpdate::make()\n    ->displayName('Safety basics')\n    ->locale(Locale::NlNL));",
        "api.v2.video.export": "$export = $hihaho->video(123)->export();",
        "api.v2.video.destroy.batch": "$hihaho->videos()->deleteMany([123, 124]);",
        "api.v2.video.move.batch": "$hihaho->videos()->moveMany([123, 124], folderId: 7);",
        "api.v2.video.swap-uuid": "$swapped = $hihaho->videos()->swap(fromUuid: 'uuid-of-the-old-video', toUuid: 'uuid-of-the-new-video');",
        "api.v2.video.allowed-viewer-token.store": "$token = $hihaho->video(123)->createViewerToken('user-42', lifetimeSeconds: 3600);\n\necho $token->playerUrl;",
        "api.v2.video.thumbnail.update": "$video = $hihaho->video(123)->thumbnails()->upload('/path/to/poster.jpg');",
        "api.v2.video.thumbnail.index": "foreach ($hihaho->video(123)->thumbnails()->list() as $thumbnail) {\n    echo $thumbnail->deliveryUrl;\n}",
        "api.v2.video.thumbnail.activate": "$hihaho->video(123)->thumbnails()->activate('thumbnail-id');",
        "api.v2.video.thumbnail.destroy": "$hihaho->video(123)->thumbnails()->delete('thumbnail-id');",
        "api.v2.video.ai-task.index": "foreach ($hihaho->video(123)->aiTasks()->list() as $task) {\n    echo $task->status?->name;\n}",
        "api.v2.video.ai-task.create": "use Hihaho\\Sdk\\Enums\\AiTaskType;\n\n$started = $hihaho->video(123)->aiTasks()->start(AiTaskType::GenerateChapters);",
        "api.v2.video.subtitles": "foreach ($hihaho->video(123)->subtitles()->list() as $subtitle) {\n    echo $subtitle->language;\n}",
        "api.v2.video.subtitle.store.batch": "use Hihaho\\Sdk\\Input\\SubtitleInput;\n\n$hihaho->video(123)->subtitles()->createMany([\n    SubtitleInput::fromFile('/path/to/en.vtt', title: 'English', language: 'en', isDefault: true),\n]);",
        "api.v2.video.statistics.aggregated": "$statistics = $hihaho->video(123)->statistics()->aggregated();",
        "api.v2.video.session.index": "use Hihaho\\Sdk\\Input\\StatisticsFilter;\n\n$filter = new StatisticsFilter(from: new DateTimeImmutable('2026-10-01'), until: new DateTimeImmutable('2026-10-31'));\n\nforeach ($hihaho->video(123)->sessions()->list($filter) as $session) {\n    echo $session->id;\n}",
        "api.v2.video.session.show": "$session = $hihaho->video(123)->sessions()->get(5001);",
        "api.v2.video.stats.views": "foreach ($hihaho->video(123)->statistics()->views() as $views) {\n    echo $views->total;\n}",
        "api.v2.video.stats.views-by-user-agent": "$viewsByUserAgent = $hihaho->video(123)->statistics()->viewsByUserAgent();",
        "api.v2.video.stats.interactions": "foreach ($hihaho->video(123)->statistics()->interactions() as $interaction) {\n    echo $interaction->id;\n}",
        "api.v2.video.stats.questions": "foreach ($hihaho->video(123)->statistics()->questions() as $question) {\n    echo $question->id;\n}",
        "api.v2.video.stats.metadata.list": "foreach ($hihaho->video(123)->statistics()->metadata() as $metadata) {\n    echo $metadata->email;\n}",
        "api.v2.video.stats.metadata.show": "$metadata = $hihaho->video(123)->statistics()->sessionMetadata(5001);",
        "api.v2.video.interaction.index": "foreach ($hihaho->video(123)->interactions()->list() as $interaction) {\n    echo $interaction->id;\n}",
        "api.v2.video.interaction.show": "$interaction = $hihaho->video(123)->interactions()->get(456);",
        "api.v2.video.interaction.store.batch": "use Hihaho\\Sdk\\Input\\Interactions\\Action;\nuse Hihaho\\Sdk\\Input\\Interactions\\TextInteraction;\n\n$ids = $hihaho->video(123)->interactions()->createMany([\n    new TextInteraction(startTime: 5, endTime: 10, text: 'Watch this', action: Action::jump(42)),\n]);",
        "api.v2.video.interaction.destroy.batch": "$hihaho->video(123)->interactions()->deleteMany([456, 457]);",
        "api.v2.video.interaction.destroy": "$hihaho->video(123)->interactions()->delete(456);",
        "api.v2.video.question.index": "foreach ($hihaho->video(123)->questions()->list() as $question) {\n    echo $question->id;\n}",
        "api.v2.video.question.show": "$question = $hihaho->video(123)->questions()->get(789);",
        "api.v2.video.question.store.batch": "use Hihaho\\Sdk\\Input\\Questions\\Answer;\nuse Hihaho\\Sdk\\Input\\Questions\\MultipleChoiceQuestion;\n\n$ids = $hihaho->video(123)->questions()->createMany([\n    new MultipleChoiceQuestion(activeAt: 30, text: 'Which one?', answers: [Answer::correct('A'), Answer::wrong('B')]),\n]);",
        "api.v2.video.question.destroy.batch": "$hihaho->video(123)->questions()->deleteMany([789, 790]);",
        "api.v2.video.question.destroy": "$hihaho->video(123)->questions()->delete(789);"
    }
}
