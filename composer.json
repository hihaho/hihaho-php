{
    "name": "hihaho/hihaho-php",
    "description": "PHP and Laravel SDK for the hihaho API",
    "keywords": [
        "hihaho",
        "hihaho-php",
        "laravel"
    ],
    "homepage": "https://www.hihaho.com",
    "license": "proprietary",
    "type": "library",
    "authors": [
        {
            "name": "hihaho",
            "homepage": "https://www.hihaho.com"
        }
    ],
    "support": {
        "docs": "https://api-docs.hihaho.com"
    },
    "require": {
        "php": "^8.4",
        "illuminate/collections": "^12.0||^13.0",
        "illuminate/contracts": "^12.0||^13.0",
        "illuminate/http": "^12.0||^13.0",
        "illuminate/support": "^12.0||^13.0",
        "spatie/laravel-package-tools": "^1.14",
        "guzzlehttp/psr7": "^2.7||^3.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.5",
        "larastan/larastan": "^3.10",
        "laravel/boost": "^2.0||^3.0",
        "laravel/pao": "^1.0",
        "laravel/pint": "^1.29",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^10.0||^11.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.0||^12.0",
        "rector/rector": "^2.5",
        "sandermuller/boost-skills": "^2.27.0",
        "sandermuller/package-boost-laravel": "^1.0",
        "spaze/phpstan-disallowed-calls": "^4.13",
        "symplify/phpstan-rules": "^14.17",
        "tomasvotruba/cognitive-complexity": "^1.2",
        "tomasvotruba/type-coverage": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "Hihaho\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hihaho\\Sdk\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "post-install-cmd": [
            "SanderMuller\\PackageBoostLaravel\\Scripts\\AutoSync::run"
        ],
        "post-update-cmd": [
            "SanderMuller\\PackageBoostLaravel\\Scripts\\AutoSync::run"
        ],
        "phpstan": "vendor/bin/phpstan analyse --memory-limit=2G",
        "phpstan-simplified": "vendor/bin/phpstan analyse --memory-limit=2G --error-format symplify",
        "phpstan-clear-cache": "vendor/bin/phpstan clear-result-cache",
        "format": "vendor/bin/pint",
        "rector": "vendor/bin/rector process",
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html=coverage",
        "sync-ai": "vendor/bin/boost sync",
        "qa": [
            "@rector",
            "@format",
            "@phpstan-simplified"
        ],
        "qa-check": [
            "vendor/bin/rector process --dry-run",
            "vendor/bin/pint --test",
            "@phpstan-simplified",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hihaho\\Sdk\\HihahoServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
